#!/usr/bin/env bash
# Claude Code PostToolUse hook (matcher: Edit|Write).
#
# If the file an agent just edited is managed by chezmoi, keep the source in
# sync (re-add) and — the important bit — tell the agent so, via a system note
# (hookSpecificOutput.additionalContext). The re-add is uncommitted work on
# main in the canonical checkout, which chezmoi-autoupdate applies as it
# stands, so the note sends the agent to the source repo's AGENTS.md: move the
# change to a branch worktree, get it reviewed, Yair pushes. We NEVER commit
# and NEVER block.
#
# Behaviour:
#   - unmanaged file  -> silent, no output (ordinary repos are unaffected)
#   - managed file    -> chezmoi re-add + a note pointing at AGENTS.md
#   - template/encrypted/modify-managed -> NO re-add; edit the source instead
#
# Always exits 0. Registered in dot_claude/settings.json. Distributed by chezmoi.

PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

command -v chezmoi >/dev/null 2>&1 || exit 0   # no chezmoi here -> nothing to do
command -v jq      >/dev/null 2>&1 || exit 0

input=$(cat)
file=$(printf '%s' "$input" | jq -r '.tool_input.file_path // empty' 2>/dev/null)
[ -n "$file" ] || exit 0

# source-path exits non-zero for paths chezmoi does not manage -> stay silent.
src=$(chezmoi source-path -- "$file" 2>/dev/null) || exit 0
repo=$(chezmoi source-path 2>/dev/null)

# Emit a system note the agent will see, then stop. jq --arg handles escaping.
emit() {
    jq -cn --arg ctx "$1" \
        '{hookSpecificOutput:{hookEventName:"PostToolUse",additionalContext:$ctx}}'
    exit 0
}

case "$src" in
    *.tmpl|*encrypted_*|*/modify_*)
        emit "chezmoi: '$file' is a TEMPLATE/ENCRYPTED/MODIFY-MANAGED chezmoi file (source: $src). No re-add was performed, and home edits may be overwritten. Make the change in that source on a branch worktree, as $repo/AGENTS.md describes. Do not run 'chezmoi apply' and do not commit on main; Yair pushes after review, then chezmoi-autoupdate applies it."
        ;;
esac

if chezmoi re-add -- "$file" >/dev/null 2>&1; then
    emit "chezmoi: '$file' is managed by chezmoi and has just been re-added to the source ($src). That is now uncommitted work on main in the canonical dotfiles checkout $repo, which chezmoi-autoupdate applies as it stands and won't pull past. Do not commit it there. Move it to a branch worktree and get it reviewed, as $repo/AGENTS.md describes; Yair pushes."
else
    emit "chezmoi: '$file' is managed by chezmoi (source: $src) but 'chezmoi re-add' failed. Make the change in the source on a branch worktree, as $repo/AGENTS.md describes."
fi
