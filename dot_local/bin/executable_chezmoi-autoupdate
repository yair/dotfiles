#!/usr/bin/env bash
# Guarded chezmoi auto-update for decentralized multi-machine sync.
#
# Fast-forward pull from origin, then apply ONLY the files that changed
# upstream AND have no local edits. Never clobbers un-pushed commits or
# locally-modified managed files; surfaces anything it can't safely handle via
# an optional notifier (see below). Designed to run unattended (systemd timer).
#
# chezmoi status columns: col1 = home-vs-last-written (local edit),
#                         col2 = home-vs-target  (upstream change to apply).
#   " M" upstream changed, home clean   -> safe to apply
#   "M ", "MM", "A " etc. col1 set      -> local edit; do NOT clobber
#
# Notifications: if an executable `chezmoi-autoupdate-notify` is on PATH, it is
# called with a one-line message for anything needing attention (diverged pull,
# conflicts, un-pushed commits). Wire it to your existing mail/Telegram. Absent
# -> messages just go to the log (journald when run under systemd).
#
# Always exits 0; safe to run on any box (no-ops where chezmoi is absent).

set -u
PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

host=$(hostname -s 2>/dev/null || echo "?")
log()    { printf '%s chezmoi-autoupdate[%s]: %s\n' "$(date '+%F %T')" "$host" "$*"; }
notify() { command -v chezmoi-autoupdate-notify >/dev/null 2>&1 && chezmoi-autoupdate-notify "$*" >/dev/null 2>&1; log "NOTIFY: $*"; }

command -v chezmoi >/dev/null 2>&1 || { log "chezmoi not installed; nothing to do"; exit 0; }
chezmoi source-path >/dev/null 2>&1 || { log "no chezmoi source repo; nothing to do"; exit 0; }

# 1) Fast-forward pull. Before that: uncommitted work in the SOURCE tree is
#    by far the most common reason a pull fails on a box whose human edits
#    dotfiles, and it is not "diverged or auth" — say what it is. Apply still
#    runs below (the tree is usable); only the pull is skipped.
dirty=$(chezmoi git -- status --porcelain --untracked-files=no 2>/dev/null | head -5)
if [ -n "$dirty" ]; then
    notify "$host: uncommitted work in the chezmoi source tree — pull skipped until it is committed or stashed: $(printf '%s' "$dirty" | tr '\n' ';')"
elif ! out=$(chezmoi git -- pull --ff-only 2>&1); then
    case "$out" in
        *"Permission denied"*|*"Could not read from remote"*|*"Host key verification"*)
            notify "$host: chezmoi pull failed — git auth (deploy key / ssh_config gh-dotfiles / BatchMode). [$out]" ;;
        *"Not possible to fast-forward"*|*"diverg"*)
            notify "$host: chezmoi pull failed — local history diverged from origin; rebase or push by hand. [$out]" ;;
        *)  notify "$host: chezmoi pull --ff-only failed. [$out]" ;;
    esac
    exit 0
fi

# 2) Un-pushed local commits are fine to apply (source already has them), but
#    remind to push so they reach the other boxes.
ahead=$(chezmoi git -- rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
[ "${ahead:-0}" -gt 0 ] && notify "$host: $ahead un-pushed chezmoi commit(s) — push so other boxes get them."

# 3) Partition the working state.
status=$(chezmoi status 2>/dev/null)
# upstream-changed, locally-clean -> apply these
mapfile -t apply_list < <(printf '%s\n' "$status" | awk 'NF && substr($0,1,1)==" " && substr($0,2,1)!=" "{print substr($0,4)}')
# changed upstream AND edited locally -> genuine conflict, leave for a human
mapfile -t conflict_list < <(printf '%s\n' "$status" | awk 'NF && substr($0,1,1)!=" " && substr($0,2,1)!=" "{print substr($0,4)}')

if [ "${#conflict_list[@]}" -gt 0 ]; then
    notify "$host: ${#conflict_list[@]} file(s) changed upstream AND edited locally — not applied: ${conflict_list[*]}"
fi

if [ "${#apply_list[@]}" -eq 0 ]; then
    log "up to date (nothing safe to apply)."
    exit 0
fi

# 4) Apply only the safe entries, one at a time. Directories are applied
#    non-recursively: a directory whose own attributes changed (e.g. mode)
#    must not drag a conflicting child into the apply, where chezmoi would
#    try to prompt, find no TTY, and abort the whole batch. Scripts
#    (run_onchange_ etc.) show up by bare name and are applied by that name.
declare -a applied=() failed=()
run_scripts=0
for rel in "${apply_list[@]}"; do
    [ -n "$rel" ] || continue
    if [ "$(printf '%s\n' "$status" | awk -v r="$rel" 'substr($0,4)==r{print substr($0,2,1)}')" = "R" ]; then
        run_scripts=1; continue           # a script: cannot be targeted by name, see below
    elif [ -d "$HOME/$rel" ]; then
        out=$(chezmoi apply --recursive=false -- "$HOME/$rel" 2>&1)
    else
        out=$(chezmoi apply -- "$HOME/$rel" 2>&1)
    fi
    if [ $? -eq 0 ]; then applied+=("$rel"); else failed+=("$rel [$out]"); fi
done
# Pending scripts (status col2 = R) run as a class; run_onchange_ ones only fire
# when their content changed, so this is a no-op when nothing is pending.
if [ "$run_scripts" -eq 1 ]; then
    if out=$(chezmoi apply --include=scripts 2>&1); then applied+=("(scripts)"); else failed+=("(scripts) [$out]"); fi
    # Scripts talk (the arming script's "lingering is off" hint above all):
    # keep what they said, success or not — it was being thrown away.
    [ -n "$out" ] && while IFS= read -r line; do log "script: $line"; done <<< "$out"
fi
[ "${#applied[@]}" -gt 0 ] && log "applied ${#applied[@]} entr(y|ies): ${applied[*]}"
[ "${#failed[@]}" -gt 0 ] && notify "$host: chezmoi apply failed for: ${failed[*]}"
exit 0
