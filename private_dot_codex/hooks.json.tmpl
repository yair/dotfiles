{
  "description": "Shared temporal context, Herdr registration and chezmoi edit feedback.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "command": "$HOME/.local/bin/codex-chezmoi-postedit-hook",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '{{ .chezmoi.homeDir }}/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "$HOME/.local/bin/claude-time-context",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
