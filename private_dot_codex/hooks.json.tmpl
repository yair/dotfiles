{
  "description": "Global temporal context for interactive Codex sessions.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '{{ .chezmoi.homeDir }}/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "$HOME/.local/bin/claude-time-context",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}